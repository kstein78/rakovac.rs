# Web server config for rakovac.rs (Caddy 2). Lives in the repo: the server copies it to
# /etc/caddy/Caddyfile and reloads Caddy within a minute after it changes on main
# (only if "caddy validate" accepts it; otherwise the old config stays).
# HTTPS certificates (Let's Encrypt) are obtained and renewed by Caddy automatically.
# (A change to this file reloads Caddy, which also retries a certificate that failed before DNS was ready.)

(site) {
	root * /srv/rakovac/current
	encode zstd gzip

	# "/" picks the visitor's language from the browser; everything else is a static file.
	@home path /
	# Serbian: "sr-Latn…" -> Latin (/sr/), plain "sr", "sr-RS", "sr-Cyrl" (Cyrillic by default) -> /cyr/;
	# Croatian, Bosnian, Montenegrin -> Latin.
	map {header.Accept-Language} {lang} {
		~^sr-Latn sr
		~^sr\b cyr
		~^(hr|bs|sh|cnr|me)\b sr
		~^(ru|uk|be)\b ru
		~^de\b de
		~^hu\b hu
		default en
	}
	handle @home {
		header Vary Accept-Language
		redir * /{lang}/ 302
	}
	# Current weather for the header (site.js): our server asks Open-Meteo (free, CC BY 4.0) for the point
	# above the village, so visitors' browsers never contact a third party. The visitor's IP address, cookies
	# and referrer are not passed on. Browsers keep the answer for 10 minutes (Open-Meteo updates every 15).
	handle /weather.json {
		rewrite * /v1/forecast?latitude=45.1958&longitude=19.7672&current=temperature_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m,wind_gusts_10m&timezone=Europe%2FBelgrade&wind_speed_unit=kmh
		reverse_proxy https://api.open-meteo.com {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -Cookie
			header_up -Referer
			header_up -Origin
			header_up User-Agent "rakovac.rs weather"
			header_down -Set-Cookie
			header_down -Access-Control-Allow-Origin
			header_down Cache-Control "public, max-age=600"
			transport http {
				dial_timeout 3s
				response_header_timeout 5s
			}
		}
	}
	handle {
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Pages are checked on every visit (cheap, thanks to ETag), so a new version shows at once.
	@html path / *.html */
	header @html Cache-Control "no-cache"
	header /version.txt Cache-Control "no-store"
	# CSS and JS have a content hash in the file name and never change.
	header /css/* Cache-Control "public, max-age=31536000, immutable"
	header /js/* Cache-Control "public, max-age=31536000, immutable"
	# Photos, fonts and downloads: one week.
	@assets path /img/* /fonts/* /downloads/* /vendor/* /favicon* /apple-touch-icon.png /icon-*.png
	header @assets Cache-Control "public, max-age=604800"

	handle_errors 404 {
		@sr path /sr/*
		@cyr path /cyr/*
		@ru path /ru/*
		@de path /de/*
		@hu path /hu/*
		handle @sr {
			rewrite * /sr/404.html
		}
		handle @cyr {
			rewrite * /cyr/404.html
		}
		handle @ru {
			rewrite * /ru/404.html
		}
		handle @de {
			rewrite * /de/404.html
		}
		handle @hu {
			rewrite * /hu/404.html
		}
		handle {
			rewrite * /en/404.html
		}
		file_server
	}
}

rakovac.rs {
	import site
}

www.rakovac.rs {
	redir https://rakovac.rs{uri} permanent
}

# Any other address on plain HTTP (e.g. http://<server IP>/): the same site, for checking the
# server before DNS points here. Not indexed by search engines.
http:// {
	import site
	header X-Robots-Tag "noindex"
}
